{
  "nodeModulesDir": "auto",
  "workspace": ["./backend", "./packages/api_ts"],
  "tasks": {
    "sync": "deno run -A scripts/sync.ts",
    "check": "deno run -A scripts/check.ts",
    "lint:boundaries": "deno run -A scripts/lint-boundaries.ts",
    "lint:deno-only": "deno run -A scripts/lint-deno-only.ts",
    "lint:workflows": "deno run -A scripts/lint-workflows.ts",
    "test:scripts": "deno test -A scripts/",
    "dev:backend": "deno task --cwd backend dev",
    "skills:update": "deno run -A npm:skills update",
    "timeline": "deno run -A scripts/timeline.ts",
    "secrets": "deno run -A scripts/secret-scan.ts --all",
    "git:setup": "deno run -A scripts/git-setup.ts",
    "setup": "deno run -A scripts/setup.ts",
    "security:sync": "deno run -A scripts/security-sync.ts",
    "protect-branch": "deno run -A scripts/protect-branch.ts",
    "release": "deno run -A scripts/release.ts",
    "add-app": "deno run -A scripts/daedalus.ts",
    "studio": "deno run -A scripts/daedalus.ts studio",
    "doctor": "deno run -A scripts/daedalus.ts doctor",
    "add-module": "deno run -A scripts/daedalus.ts module",
    "add-pack": "deno run -A scripts/daedalus.ts pack"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "**/node_modules",
      "**/dist",
      "**/build",
      "packages/api_ts/src/schema.d.ts",
      "backend/drizzle",
      ".agents",
      ".claude",
      "apps"
    ]
  },
  "lint": {
    "exclude": [
      "**/node_modules",
      "**/dist",
      "**/build",
      "packages/api_ts/src/schema.d.ts",
      "backend/drizzle",
      ".agents",
      ".claude",
      "apps"
    ]
  }
}
