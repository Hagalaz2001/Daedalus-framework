# Copy to backend/.env (never commit it). Variables are validated at boot; every problem is reported together.
# Environment: development | test | production
APP_ENV=development
PORT=8787
# Postgres. Leave empty for the built-in local database (PGlite in backend/.data/).
# Supabase / Neon / self-hosted: use the connection string (the pooler URL in production).
DATABASE_URL=
# Accounts (Better Auth). Required in production: 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The API's public URL, e.g. https://api.example.com (required in production)
BETTER_AUTH_URL=
# Web origins allowed to call the API with cookies, comma-separated (required in production)
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info
# Requests per minute per client address
RATE_LIMIT_PER_MINUTE=120
# true only behind a reverse proxy you control (reads X-Forwarded-For for rate limiting)
TRUST_PROXY=false
# Platform operators (admin module, feature flags), comma-separated emails
ADMIN_EMAILS=
