{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --no-prompt --allow-read --allow-env \"$CLAUDE_PROJECT_DIR/scripts/ai/guard.ts\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Read(./**/*.pem)"]
  }
}
