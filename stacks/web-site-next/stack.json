{
  "id": "web-site-next",
  "kind": "web",
  "flag": "site-next",
  "label": "Website with server features (Next.js)",
  "description": "Marketing site and blog: Next.js App Router (React + TypeScript, static generation) under pure Deno, Tailwind v4, the shared UI kit, metadata API, Open Graph images, sitemap, robots, JSON-LD.",
  "defaultAppDir": "apps/site",
  "workspaceMember": true,
  "export": { "kind": "react", "label": "React + shadcn/ui kit" },
  "packages": ["packages/api_ts", "shared:web-shared/packages/ui"],
  "tokens": "deno run -A scripts/tokens/web.ts",
  "placeholders": { "{displayName}": ["src/shared/lib/site.ts", "README.md"] },
  "tasks": { "dev:site-next": "deno task --cwd {appDir} dev" },
  "check": ["deno task --cwd {appDir} check"],
  "boundaries": { "lang": "ts", "src": "src" },
  "requires": { "backend": "optional" }
}
