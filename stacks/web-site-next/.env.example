# Public URL of the site (no trailing slash). Used for canonical links, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend URL for packages/api_ts (the footer shows its /health status when reachable).
API_BASE_URL=http://localhost:8787
# Required for the contact form to deliver (without it the form shows an error): where it POSTs messages as JSON (a form service, a Slack webhook, your backend).
CONTACT_WEBHOOK_URL=
