{
  "id": "web-spa",
  "kind": "web",
  "flag": "spa",
  "label": "Web app (React SPA)",
  "description": "React 19 + Vite + TypeScript + Tailwind v4 + TanStack Query + React Router + Better Auth cookie client, with the shared shadcn-style UI kit.",
  "defaultAppDir": "apps/web",
  "workspaceMember": true,
  "export": { "kind": "react", "label": "React + shadcn/ui kit" },
  "packages": ["packages/api_ts", "shared:web-shared/packages/ui"],
  "tokens": "deno run -A scripts/tokens/web.ts",
  "placeholders": { "{displayName}": ["src/shared/lib/config.ts", "index.html"] },
  "tasks": { "dev:web": "deno task --cwd {appDir} dev" },
  "check": ["deno task --cwd {appDir} check"],
  "boundaries": { "lang": "ts", "src": "src" },
  "requires": { "backend": "optional" }
}
