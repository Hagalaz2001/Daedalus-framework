{
  "id": "web-site-astro",
  "kind": "web",
  "flag": "site",
  "label": "Website (Astro, static, SEO)",
  "description": "Marketing site and blog: Astro 7 with static output, content collections, interactive islands in React or Vue, Tailwind v4, the shared UI kit, canonical/Open Graph/JSON-LD, sitemap, robots, a default Open Graph image generated from the tokens (per-page images are opt-in).",
  "defaultAppDir": "apps/site",
  "workspaceMember": true,
  "packages": [
    "packages/api_ts"
  ],
  "variants": {
    "key": "islands",
    "default": "react",
    "values": {
      "react": {
        "packages": [
          "shared:web-shared/packages/ui"
        ],
        "overlay": "variants/react",
        "tokens": "deno run -A scripts/tokens/web.ts"
      },
      "vue": {
        "packages": [
          "shared:web-shared/packages/ui-vue"
        ],
        "overlay": "variants/vue",
        "tokens": "deno run -A scripts/tokens/web.ts"
      }
    }
  },
  "placeholders": {
    "{displayName}": [
      "src/lib/site.ts",
      "README.md"
    ],
    "{islands}": [
      "README.md"
    ]
  },
  "tasks": {
    "dev:site": "deno task --cwd {appDir} dev"
  },
  "check": [
    "deno task --cwd {appDir} check"
  ],
  "boundaries": {
    "lang": "ts",
    "src": "src"
  },
  "requires": {
    "backend": "optional"
  },
  "sync": [
    {
      "cwd": "{appDir}",
      "run": "deno task og:default"
    }
  ]
}
