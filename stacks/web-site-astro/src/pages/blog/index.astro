---
import Container from '../../components/Container.astro'
import PostList from '../../components/PostList.astro'
import Base from '../../layouts/Base.astro'
import { getPosts } from '../../lib/posts'

const posts = await getPosts()
---

<Base title="Journal" description="Notes on writing, focus and building a calm product." path="/blog">
  <Container class="pt-16 sm:pt-24">
    <h1 class="font-display text-5xl font-semibold tracking-tight sm:text-6xl">Journal</h1>
    <p class="mt-4 mb-12 max-w-xl text-xl text-text-muted">Notes on writing, focus and building a calm product.</p>
    <PostList posts={posts} />
  </Container>
</Base>
