---
import Container from '../components/Container.astro'
import Base from '../layouts/Base.astro'
import { buttonVariants, cn } from '../lib/kit'
---

<Base title="Page not found" description="This page does not exist." path="/404" noindex>
  <Container class="py-32">
    <p class="font-display text-8xl font-semibold tracking-tight text-primary">404</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight">This page wandered off.</h1>
    <p class="mt-3 max-w-md text-xl text-text-muted">The link may be old, or the address mistyped.</p>
    <a href="/" class={cn(buttonVariants({ size: 'lg' }), 'mt-8')}>Back to the homepage</a>
  </Container>
</Base>
