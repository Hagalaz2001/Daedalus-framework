---
import Container from '../components/Container.astro'
import ContactForm from '../islands/ContactForm.astro'
import Base from '../layouts/Base.astro'
import { siteConfig } from '../lib/site'
---

<Base title="Contact" description="Questions, feedback or a partnership idea: write to us." path="/contact">
  <Container class="pt-16 sm:pt-24">
    <div class="grid gap-14 grid-cols-1 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <h1 class="font-display text-5xl font-semibold tracking-tight sm:text-6xl">Say hello.</h1>
        <p class="mt-5 max-w-md text-xl text-text-muted">A real person reads every message. We usually answer within two working days.</p>
        <p class="mt-8 text-text-muted">
          Prefer email? <a href={`mailto:${siteConfig.contactEmail}`} class="font-medium text-primary underline underline-offset-4">{siteConfig.contactEmail}</a>
        </p>
      </div>
      <ContactForm endpoint={siteConfig.contactEndpoint} />
    </div>
  </Container>
</Base>
