---
import { siteConfig } from '../lib/site'
import Container from './Container.astro'

const columns = [
  { title: 'Product', links: [{ href: '/pricing', label: 'Pricing' }, { href: '/blog', label: 'Journal' }] },
  { title: 'Company', links: [{ href: '/about', label: 'About' }, { href: '/contact', label: 'Contact' }] },
  { title: 'Legal', links: [{ href: '/privacy', label: 'Privacy' }, { href: '/terms', label: 'Terms' }] },
]
---

<footer class="mt-32 border-t border-border bg-surface-muted/50">
  <Container class="grid gap-12 py-14 grid-cols-1 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <p class="font-display text-xl font-semibold">{siteConfig.name}</p>
      <p class="mt-3 max-w-xs text-text-muted">{siteConfig.tagline}.</p>
    </div>
    {
      columns.map((c) => (
        <nav aria-label={c.title}>
          <p class="text-sm font-semibold">{c.title}</p>
          <ul class="mt-3 space-y-1">
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="inline-flex min-h-11 items-center text-text-muted hover:text-text">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </Container>
  <Container class="flex flex-wrap items-center justify-between gap-3 border-t border-border py-6 text-sm text-text-muted">
    <p>© {new Date().getFullYear()} {siteConfig.name}</p>
    <p id="api-status" hidden class="inline-flex items-center gap-2">
      <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
      All systems operational
    </p>
  </Container>
</footer>

<script>
  // Backend status through the generated client (@app/api). Shown only when PUBLIC_API_BASE_URL is set and /health answers.
  import { createApi } from '@app/api'

  const base = import.meta.env.PUBLIC_API_BASE_URL as string | undefined
  if (base) {
    createApi(base)
      .GET('/health')
      .then(({ data }) => {
        if (data?.status === 'ok') document.getElementById('api-status')?.removeAttribute('hidden')
      })
      .catch(() => {})
  }
</script>
