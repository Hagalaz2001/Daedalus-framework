---
import { faqs } from '../lib/content'
import Icon from './Icon.astro'
---

<!-- Native <details>: keyboard and screen-reader support for free, works without JavaScript. -->
<div class="divide-y divide-border border-y border-border">
  {
    faqs.map((f) => (
      <details class="group">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-medium [&::-webkit-details-marker]:hidden">
          {f.q}
          <Icon name="chevron-down" class="size-5 shrink-0 text-text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none" />
        </summary>
        <p class="max-w-2xl pb-5 text-text-muted">{f.a}</p>
      </details>
    ))
  }
</div>
