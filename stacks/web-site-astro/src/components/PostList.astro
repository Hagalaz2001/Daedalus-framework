---
import { formatPostDate, readingMinutes, type Post } from '../lib/posts'

interface Props {
  posts: Post[]
}
const { posts } = Astro.props
---

{
  posts.length === 0 ? (
    <p class="rounded-lg border border-dashed border-border p-10 text-center text-text-muted">No posts yet. Add a Markdown file to src/content/blog.</p>
  ) : (
    <ul class="divide-y divide-border border-y border-border">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`} class="group grid gap-2 py-8 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <time datetime={p.data.date.toISOString()} class="text-sm text-text-muted sm:pt-2">{formatPostDate(p.data.date)}</time>
            <div>
              <h2 class="font-display text-2xl font-semibold underline-offset-4 group-hover:underline sm:text-3xl">{p.data.title}</h2>
              <p class="mt-2 max-w-xl text-text-muted">{p.data.description}</p>
              <p class="mt-3 text-sm text-text-muted">{readingMinutes(p.body ?? '')} min read</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
