---
import Icon from './Icon.astro'
import { buttonVariants } from '../lib/kit'
import Container from './Container.astro'

const rows = [
  ['Plan the launch checklist', 'Pricing page copy, release notes, email to the waitlist', '2m'],
  ['Onboarding: three steps, always skippable', 'Cut the survey. Ask for the name only.', '1h'],
  ['Call the accountant about Q4', 'Bring the receipts folder', 'Mon'],
  ['Oat milk', '', 'Sun'],
]
---

<section class="pt-16 pb-12 sm:pt-24">
  <Container class="grid items-center gap-14 grid-cols-1 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <h1 class="font-display text-5xl leading-[1.02] font-semibold tracking-tight sm:text-7xl">Write it down.<br />Find it later.</h1>
      <p class="mt-6 max-w-lg text-xl text-text-muted">A quiet notebook with fast search. No folders to maintain, no editor to learn, nothing between you and the next thought.</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="/pricing" class={buttonVariants({ size: 'lg' })}>Start free <Icon name="arrow-right" /></a>
        <a href="/blog" class={buttonVariants({ size: 'lg', variant: 'ghost' })}>Read the journal</a>
      </div>
      <p class="mt-5 text-sm text-text-muted">Free for personal use. No card needed.</p>
    </div>
    <!-- The product, drawn with plain markup in the brand tokens, so the page shows what you get. -->
    <div aria-hidden="true" class="relative">
      <div class="overflow-hidden rounded-lg border border-border bg-surface shadow-2xl shadow-scrim/25">
        <div class="flex items-center gap-2 border-b border-border bg-surface-muted px-4 py-3">
          <span class="size-2.5 rounded-full bg-border"></span><span class="size-2.5 rounded-full bg-border"></span><span class="size-2.5 rounded-full bg-border"></span>
        </div>
        <div class="p-5">
          <div class="flex h-11 items-center gap-2.5 rounded-md border border-primary px-3.5 text-text-muted">
            <span class="text-text">launch</span>
            <span class="h-5 w-px animate-pulse bg-primary motion-reduce:animate-none"></span>
          </div>
          <ul class="mt-4 divide-y divide-border">
            {
              rows.map(([t, s, when], i) => (
                <li class={`flex items-center justify-between gap-4 py-3 ${i === 0 ? '' : 'opacity-60'}`}>
                  <div class="min-w-0">
                    <p class="truncate font-medium">
                      {i === 0 ? (
                        <>
                          <mark class="rounded-sm bg-primary/20 px-0.5 text-text">Plan the launch</mark> checklist
                        </>
                      ) : (
                        t
                      )}
                    </p>
                    {s && <p class="truncate text-sm text-text-muted">{s}</p>}
                  </div>
                  <span class="shrink-0 text-sm text-text-muted">{when}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <span class="absolute -bottom-3 left-6 inline-flex items-center rounded-full bg-surface px-2.5 py-0.5 text-xs font-semibold text-success ring-1 ring-border">Saved just now</span>
    </div>
  </Container>
</section>
