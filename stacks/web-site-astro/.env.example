# Public URL of the site (no trailing slash). Canonical links, sitemap and Open Graph use it.
SITE_URL=http://localhost:4321
# Where the "Open the app" buttons point.
PUBLIC_APP_URL=http://localhost:5173
# Backend URL for packages/api_ts: the footer shows "All systems operational" when its /health answers (needs CORS for this origin).
PUBLIC_API_BASE_URL=
# Where the contact form POSTs JSON (a form service, a chat webhook or your backend). Empty: the form says it is not connected.
PUBLIC_CONTACT_ENDPOINT=
