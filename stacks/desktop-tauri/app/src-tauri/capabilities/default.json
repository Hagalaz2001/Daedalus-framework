{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do: call its own commands and reach the backend through the Rust HTTP client. Nothing else (no shell, no file system, no opener).",
  "windows": ["main"],
  "permissions": [
    "allow-token-get",
    "allow-token-set",
    "allow-token-clear",
    "allow-theme-apply",
    "allow-app-ready",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://localhost:8787/*" }, { "url": "http://127.0.0.1:8787/*" }]
    }
  ]
}
