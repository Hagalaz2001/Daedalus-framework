---
import "../styles/brand.css";
import "../styles/site.css";
import Logo from "../components/Logo.astro";
import { REPO, SITE, url } from "../lib/site";
import fraunces from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  path: string;
  nav?: "showcase" | "demo" | "";
}
const { title, description, path, nav = "" } = Astro.props;
const canonical = `${SITE}${path}`;
const og = `${SITE}/og.png`;
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Daedalus",
  description,
  codeRepository: REPO,
  license: "https://opensource.org/license/mit",
  programmingLanguage: "TypeScript",
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#0d1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f0e6" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daedalus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      // Same storage key as the docs theme switch, so the choice carries across both.
      (function () {
        var t = "";
        try { t = localStorage.getItem("starlight-theme") || ""; } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top-in">
        <a class="brand" href={url("/")} aria-label="Daedalus, home"><Logo /><span>Daedalus</span></a>
        <nav aria-label="Primary">
          <a href={url("/demo/")} aria-current={nav === "demo" ? "page" : undefined}>Watch it work</a>
          <a href={url("/showcase/")} aria-current={nav === "showcase" ? "page" : undefined}>Examples</a>
          <a class="hide-sm" href={url("/developers/")}>For developers</a>
          <button class="theme" type="button" aria-label="Switch between light and dark theme" id="theme-toggle">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="foot-in">
        <div>
          <a class="brand" href={url("/")}><Logo /><span>Daedalus</span></a>
          <p class="muted">Free and open source. AI can make mistakes, so please check what it builds. You are responsible for what you ship.</p>
        </div>
        <ul>
          <li><a href={url("/demo/")}>Watch it work</a></li>
          <li><a href={url("/showcase/")}>Examples</a></li>
          <li><a href={url("/developers/")}>For developers</a></li>
          <li><a href={url("/ai/disclaimer/")}>Important note about AI</a></li>
        </ul>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("starlight-theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>
