---
import Base from "../layouts/Base.astro";
import Themed from "../components/Themed.astro";
import { pick, url } from "../lib/site";
import "../styles/home.css";

const hero = pick("web-spa", "dashboard");
const phone = pick("mobile-rn", "05-home");

const strip = [
  pick("web-site-astro", "landing"),
  pick("web-spa", "dashboard"),
  pick("mobile-rn", "05-home"),
  pick("desktop-gpui", "dashboard"),
].filter((i): i is NonNullable<typeof i> => Boolean(i));

const title = "Daedalus: your website, phone app and desktop app, built together";
const description = "Daedalus builds a website, a phone app and a desktop app from one plan. AI does the building, you make the decisions. Free and open source.";
---
<Base title={title} description={description} path="/">
  <section class="h-hero">
    <div class="wrap h-hero-grid">
      <div>
        <p class="h-eyebrow">Free and open source</p>
        <h1>Your website and apps, built together.</h1>
        <p class="h-lead">A website, a phone app and a desktop app from one plan. AI does the building. You make the decisions.</p>
        <p class="h-cta">
          <a class="btn primary big" href={url("/demo/")}>Watch it work</a>
          <a class="h-link" href={url("/showcase/")}>See examples</a>
        </p>
      </div>
      <div class="stage h-stage" aria-label="A website and a phone app made with Daedalus">
        <div class="browser">
          <div class="browser-bar"><i></i><i></i><i></i></div>
          <Themed item={hero} alt="A dashboard made with Daedalus, shown in a browser" widths={[640, 960, 1200]} sizes="(min-width: 62rem) 45vw, 92vw" eager />
        </div>
        <div class="phone"><Themed item={phone} alt="The same product as a phone app" widths={[220, 340, 440]} sizes="(min-width: 62rem) 12vw, 30vw" eager /></div>
      </div>
    </div>
  </section>

  <section class="h-sec">
    <div class="wrap">
      <h2>What you get</h2>
      <div class="h-cards">
        <article class="h-card">
          <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="9" width="30" height="21" rx="3" /><path d="M13 38h14M20 30v8" /><rect x="32" y="19" width="11" height="20" rx="3" class="a" /></svg>
          <h3>One plan, every device</h3>
          <p>A website, a phone app and a desktop app made together. Change something once and they all follow.</p>
        </article>
        <article class="h-card">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 6l3.5 9.5L37 19l-9.5 3.500L24 32l-3.500-9.500L11 19l9.500-3.500z" class="a" /><path d="M37 30l1.800 4.200L43 36l-4.200 1.800L37 42l-1.800-4.200L31 36l4.200-1.800z" /></svg>
          <h3>AI builds, you decide</h3>
          <p>Say what you want in plain words. AI drafts it. You choose what you like and approve every change.</p>
        </article>
        <article class="h-card">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5l15 5v11c0 9-6 16-15 20C15 37 9 30 9 21V10z" /><path d="M17 24l5 5 9-10" class="a" /></svg>
          <h3>Good looking and safe</h3>
          <p>Clean design in light and dark, and safety checks built in from the very first day.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="h-sec h-tint">
    <div class="wrap h-demo">
      <div>
        <h2>See it work in about a minute</h2>
        <p class="h-lead">Type a request. Watch the design appear. Pick the one you like and see it on a website, a phone and a desktop.</p>
        <p><a class="btn primary big" href={url("/demo/")}>Watch it work</a></p>
      </div>
      <a class="h-poster" href={url("/demo/")} aria-label="Open the live demo">
        <Themed item={pick("web-spa", "notes")} alt="" widths={[480, 800]} sizes="(min-width: 62rem) 40vw, 90vw" />
        <span class="h-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.500v13l11-6.500z" /></svg></span>
      </a>
    </div>
  </section>

  <section class="h-sec">
    <div class="wrap">
      <h2>Made with Daedalus</h2>
      <p class="h-lead">Real screens from real apps, in light and dark.</p>
    </div>
    <div class="h-strip" tabindex="0" role="region" aria-label="Example screens, scroll sideways">
      {strip.map((i) => (
        <figure class:list={[i.shape === "phone" && "is-phone"]}>
          <Themed item={i} alt={i.caption} widths={i.shape === "phone" ? [200, 360] : [480, 760]} sizes={i.shape === "phone" ? "12rem" : "(min-width: 40rem) 28rem, 78vw"} />
        </figure>
      ))}
    </div>
    <div class="wrap"><a class="btn big" href={url("/showcase/")}>See all examples</a></div>
  </section>

  <section class="h-sec">
    <div class="wrap">
      <h2>Why not start from scratch?</h2>
      <p class="h-lead">Every app needs the same groundwork first. Daedalus has it ready, connected and checked.</p>
      <div class="h-compare">
        <div>
          <h3>From scratch</h3>
          <ul>
            <li>Set up three separate projects</li>
            <li>Build sign-in and accounts</li>
            <li>Wire up a database and server</li>
            <li>Choose colours and fonts for each app</li>
            <li>Draw and build every first screen</li>
            <li>Add tests and safety checks later</li>
            <li>Build a way to publish</li>
          </ul>
        </div>
        <div class="with">
          <h3>With Daedalus</h3>
          <ul>
            <li>One plan for the website, phone and desktop</li>
            <li>Sign-in and accounts included</li>
            <li>Database and server already connected</li>
            <li>One look shared by every app</li>
            <li>Ready-made screens, with empty and error states</li>
            <li>Tests and safety checks on from day one</li>
            <li>A working way to publish</li>
          </ul>
        </div>
      </div>
      <p class="h-note">You own all the code and can change anything. It is a starting point, not a cage. It is not for a tiny one-page site, a quick throwaway test, or a project that needs different technology. <a href={url("/getting-started/why-daedalus/")}>Read more</a></p>
    </div>
  </section>

  <section class="h-sec h-tint">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="h-steps">
        <li>
          <svg viewBox="0 0 96 72" aria-hidden="true"><rect x="8" y="8" width="64" height="38" rx="10" /><path d="M24 46l-6 14 18-14" /><path d="M20 22h40M20 32h26" class="a" /></svg>
          <h3>1. Say what you want</h3>
          <p>Describe it in your own words, like you would to a colleague.</p>
        </li>
        <li>
          <svg viewBox="0 0 96 72" aria-hidden="true"><rect x="4" y="14" width="24" height="44" rx="6" /><rect x="36" y="14" width="24" height="44" rx="6" class="a" /><rect x="68" y="14" width="24" height="44" rx="6" /></svg>
          <h3>2. Pick your favourite</h3>
          <p>AI shows you three different designs. You keep the one you like.</p>
        </li>
        <li>
          <svg viewBox="0 0 96 72" aria-hidden="true"><rect x="6" y="10" width="46" height="32" rx="4" /><rect x="60" y="22" width="20" height="38" rx="5" class="a" /><path d="M20 52h18M29 42v10" /></svg>
          <h3>3. Get your apps</h3>
          <p>Your website, phone app and desktop app, checked and ready to grow.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="h-sec">
    <div class="wrap">
      <h2>You can trust it</h2>
      <div class="h-trust">
        <div><h3>Free and open source</h3><p>Anyone can read it, use it and improve it. No lock-in.</p></div>
        <div><h3>You stay in control</h3><p>Nothing changes until you say yes. You always see what it plans to do.</p></div>
        <div><h3>AI can make mistakes</h3><p>So please check what it builds. You are responsible for what you ship. <a href={url("/ai/disclaimer/")}>Read the full note</a>.</p></div>
      </div>
    </div>
  </section>

  <section class="h-sec h-end">
    <div class="wrap">
      <h2>Ready to try it?</h2>
      <p class="h-cta c"><a class="btn primary big" href={url("/demo/")}>Watch it work</a><a class="btn big" href={url("/developers/")}>For developers</a></p>
    </div>
  </section>
</Base>
