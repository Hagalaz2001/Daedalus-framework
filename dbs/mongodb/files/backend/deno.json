{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@app/api": "../packages/api_ts/src/index.ts",
    "@better-auth/mongo-adapter": "npm:@better-auth/mongo-adapter@1.7.25",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@0.12.20",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs/": "jsr:/@std/fs@1.0.24/",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "ajv": "npm:ajv@8.20.0",
    "ajv/dist/2020.js": "npm:ajv@8.20.0/dist/2020.js",
    "ajv-formats": "npm:ajv-formats@3.0.1",
    "better-auth": "npm:better-auth@1.7.25",
    "better-auth/": "npm:/better-auth@1.7.25/",
    "hono": "npm:hono@4.13.18",
    "hono/": "npm:/hono@4.13.18/",
    "mongodb": "npm:mongodb@7.8.0",
    "mongodb-memory-server": "npm:mongodb-memory-server@11.3.0",
    "mongoose": "npm:mongoose@9.12.1",
    "uuid": "npm:uuid@14.0.3"
  },
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "start": "deno run -A src/main.ts",
    "test": "deno test -A",
    "typecheck": "deno check src scripts migrations",
    "migrate": "deno run -A scripts/migrate.ts",
    "modules:apply": "deno run -A scripts/modules-apply.ts",
    "seed": "deno run -A scripts/seed.ts",
    "diagrams": "deno run -A scripts/diagrams.ts",
    "check": "deno fmt --check && deno lint && deno task typecheck && deno task test && deno task diagrams --check"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules"
    ]
  }
}
