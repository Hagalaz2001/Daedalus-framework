# Copy to studio/.env (or put these in your project's .env). Never commit the real file.

# Which model writes the designs: auto (default: your Anthropic key, then Lemonade, then Ollama, then demo fixtures),
# anthropic, lemonade, ollama, or fake (fixtures, no network).
STUDIO_PROVIDER=auto

# Anthropic (first-class). Bring your own key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Local AI through Lemonade (free, private, no subscription): https://lemonade-server.ai/ , see docs/LOCAL-AI.md
LEMONADE_BASE_URL=http://localhost:13305/api/v1
# LEMONADE_API_KEY=
# LEMONADE_MODEL=

# Ollama (offline and free, lower quality). https://ollama.com/
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder

# Optional second engine: Google Stitch (https://stitch.withgoogle.com/).
STITCH_API_KEY=

# Studio server port, and the browser used for screenshots (chrome, msedge, chromium) or an explicit executable.
STUDIO_PORT=4310
STUDIO_BROWSER=chrome
# STUDIO_BROWSER_PATH=
