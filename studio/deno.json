{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ]
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@1.8.0",
    "@google/stitch-sdk": "npm:@google/stitch-sdk@0.3.5",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/testing": "jsr:@std/testing@1.0.21",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.5",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.3.0",
    "cheerio": "npm:cheerio@1.2.0",
    "lucide-react": "npm:lucide-react@1.73.0",
    "playwright-core": "npm:playwright-core@1.65.1",
    "react": "npm:react@19.3.1",
    "react-dom": "npm:react-dom@19.3.1",
    "tailwindcss": "npm:tailwindcss@4.3.5",
    "vite": "npm:vite@8.3.8"
  },
  "tasks": {
    "start": "deno run -A server/main.ts",
    "build": "deno run -A npm:vite@8.3.8 build --config ui/vite.config.ts ui",
    "dev": "deno run -A npm:vite@8.3.8 --config ui/vite.config.ts ui",
    "test": "deno test -A server/ ui/test/",
    "check": "deno check server/main.ts ui/src/main.tsx && deno task test"
  },
  "fmt": {
    "lineWidth": 140,
    "exclude": [
      "./ui/dist/",
      "./.demo-project/",
      "node_modules",
      "./shared/design/vendor/"
    ]
  },
  "lint": {
    "exclude": [
      "./ui/dist/",
      "./.demo-project/",
      "node_modules",
      "./shared/design/vendor/"
    ],
    "rules": {
      "exclude": [
        "require-await"
      ]
    }
  }
}
